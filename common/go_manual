# vim: ft=sh

ARCH=$(uname -m)
case $ARCH in
  x86_64)
    ARCH=amd64
    ;;
  aarch64)
    ARCH=arm64
    ;;
  *)
    echo "Unsupported architecture: $ARCH"
    exit 1
    ;;
esac
GO_BALL=go1.23.4.linux-${ARCH}.tar.gz
pushd $HOME
  rm -f ${GO_BALL}
  rm -rf go
  curl -LOsS https://dl.google.com/go/${GO_BALL}
  tar zxf ${GO_BALL}
popd

mkdir -p $HOME/bin
export PATH=$HOME/bin:$PATH
pushd $HOME/bin
  ln -fs $HOME/go/bin/* .
popd
